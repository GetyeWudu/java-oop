  /**
   * Loads the admin password from file
   */
  private static void loadAdminPassword() {
    File file = new File(PASSWORD_FILE);
    if (!file.exists()) {
      System.out.println("No existing password file found. Using default password.");
      return;
    }

    try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(file))) {
      adminPassword = (String) ois.readObject();
      System.out.println("Admin password loaded successfully.");
    } catch (IOException | ClassNotFoundException e) {
      System.err.println("Error loading admin password: " + e.getMessage());
      System.out.println("Using default password.");
    }
  }

  /**
   * Saves the admin password to file
   */
  private static void saveAdminPassword() {
    try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(PASSWORD_FILE))) {
      oos.writeObject(adminPassword);
      System.out.println("Admin password saved successfully.");
    } catch (IOException e) {
      System.err.println("Error saving admin password: " + e.getMessage());
    }
  }

  /**
   * Authenticates admin access with password
   * 
   * @return true if authentication successful, false otherwise
   */
  private static boolean authenticateAdmin() {
    Scanner s = new Scanner(System.in);
    System.out.print("Enter admin password: ");
    String inputPassword = s.nextLine();

    if (inputPassword.equals(adminPassword)) {
      return true;
    } else {
      System.out.println("Incorrect password. Access denied.");
      return false;
    }
  }

  /**
   * Changes the admin password after verifying current password
   */
  private static void changeAdminPassword() {
    Scanner s = new Scanner(System.in);

    // Verify current password first
    System.out.print("Enter current admin password: ");
    String currentPassword = s.nextLine();

    if (!currentPassword.equals(adminPassword)) {
      System.out.println("Incorrect current password. Password not changed.");
      return;
    }

    // Get new password
    System.out.print("Enter new admin password: ");
    String newPassword1 = s.nextLine();

    System.out.print("Confirm new admin password: ");
    String newPassword2 = s.nextLine();

    if (newPassword1.equals(newPassword2)) {
      adminPassword = newPassword1;
      saveAdminPassword();
      System.out.println("Password changed successfully.");
    } else {
      System.out.println("Passwords do not match. Password not changed.");
    }
  }

