class Account implements Serializable {
  private static final long serialVersionUID = 1L;
  private String Hname;
  private int accNo;
  private double balance;
  private double curBalance;

  public Account(String hname, int accNo, double balance) {
    Hname = hname;
    this.accNo = accNo;
    this.balance = balance;
    this.curBalance = balance;
  }

  public String getHname() {
    return Hname;
  }

  public int getAccNo() {
    return accNo;
  }

  public double getcurBalance() {
    return curBalance;
  }

  public double getBalance() {
    return (balance > 50) ? balance : 50;
  }

  public void setHname(String hname) {
    Hname = hname;
  }

  public void setAccNo(int accNo) {
    this.accNo = accNo;
  }

  public void setcurBalance(double curBalance) {
    this.curBalance = curBalance;
  }

  public void setBalance(double balance) {
    this.balance = balance;
  }

  public void displayInfo() {
    System.out.println(
        "            " + Hname + "              " + accNo + "               " + balance + "             "
            + curBalance);
  }
}

class Loan implements Serializable {
  private static final long serialVersionUID = 1L;
  private int AccNo;
  private double interestRate;
  private double loanDuration;
  private double loanAmount;
  private double remainingAmount;

  public Loan(int AccNo, double loanAmount, double interestRate, double loanDuration) {
    this.AccNo = AccNo;
    this.interestRate = interestRate;
    this.loanDuration = loanDuration;
    this.loanAmount = loanAmount;
    this.remainingAmount = loanAmount + (loanAmount * interestRate * loanDuration / 12);
  }

  public int getAccNo() {
    return AccNo;
  }

  public void setAccNo(int accNo) {
    AccNo = accNo;
  }

  public double getInterestRate() {
    return interestRate;
  }

  public void setInterestRate(double interestRate) {
    this.interestRate = interestRate;
  }

  public double getLoanDuration() {
    return loanDuration;
  }

  public void setLoanDuration(double loanDuration) {
    this.loanDuration = loanDuration;
  }

  public double getLoanAmount() {
    return loanAmount;
  }

  public void setLoanAmount(double loanAmount) {
    this.loanAmount = loanAmount;
  }

  public double getRemainingAmount() {
    return remainingAmount;
  }

  public void setRemainingAmount(double remainingAmount) {
    this.remainingAmount = remainingAmount;
  }

  public void makePayment(double amount) {
    if (amount > 0 && amount <= remainingAmount) {
      remainingAmount -= amount;
      System.out.println("Payment of $" + amount + " made. Remaining loan amount: $" + remainingAmount);
    } else {
      System.out.println("Invalid payment amount.");
    }
  }

  public void displayInfo() {
    System.out.println("Loan for Account: " + AccNo);
    System.out.println("Initial Loan Amount: " + loanAmount);
    System.out.println("Interest Rate: " + (interestRate * 100) + " %");
    System.out.println("Duration: " + loanDuration + " months");
    System.out.println("Remaining Amount: " + remainingAmount);
  }
}

