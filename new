      return;
    } else {
      boolean isFound = false;

      for (int j = 0; j < loans.size(); ++j) {
        if (loans.get(j).getAccNo() == AccNo) {
          isFound = true;
          System.out.println("Enter Amount To pay your loan ");
          double paymentAmount = sc.nextDouble();
          if (paymentAmount > 0) {
            if (loans.get(j).getRemainingAmount() > paymentAmount) {
              loans.get(j).setRemainingAmount(loans.get(j).getRemainingAmount() - paymentAmount);
              System.out.println("your remaining amount from your loan is :" + loans.get(j).getRemainingAmount());
            } else if (loans.get(j).getRemainingAmount() == paymentAmount) {
              loans.get(j).setRemainingAmount(0.0);
              System.out.println("You have successfully paid your loan. You can Aplay for another loan");

            } else if (loans.get(j).getRemainingAmount() < paymentAmount) {

              double profit = paymentAmount - loans.get(j).getRemainingAmount();
              loans.get(j).setRemainingAmount(0.0);
              for (int i = 0; i < Acc.size(); ++i) {
                if (Acc.get(i).getAccNo() == AccNo) {
                  Acc.get(i).setcurBalance(profit);
                }
              }

              System.out.println("You have successfully paid your loan. You can Aplay for another loan");
              System.out.println(profit + " Transfered to your account");
            }
          } else {
            System.out.println("invalid input payment loan can not be negative or zero");
            return;
          }
        }
      }

      if (!isFound) {
        System.out.println("Wrong Account Number");
        return;
      }
    }

  }
