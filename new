  public static void depositMoney() {
    Scanner s = new Scanner(System.in);
    System.out.print("Enter Account Number :");
    int AccNo = s.nextInt();
    if (Acc.isEmpty()) {
      System.out.println("There is no registered account!!");
      return;
    }

    boolean accountFound = false;
    Scanner sc = new Scanner(System.in);

    try {
      for (int i = 0; i < Acc.size(); i++) {
        if (Acc.get(i).getAccNo() == AccNo) {
          accountFound = true;
          System.out.print("Enter Deposit Amount: ");
          double amount = sc.nextDouble();

          if (amount <= 0) {
            System.out.println("Deposit amount must be positive!");
            return;
          }

          // Assuming setCurrentBalance adds to existing balance
          Acc.get(i).setcurBalance(Acc.get(i).getcurBalance() + amount);
          System.out.println("$" + amount + " deposited successfully.");
          System.out.println("New balance: $" + Acc.get(i).getcurBalance());
          break;
        }
      }

      if (!accountFound) {
        System.out.println("Account not found!");
      }
    } finally {
      // sc.close(); // Ensure scanner is closed
    }
  }

